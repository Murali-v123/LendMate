# ==============================================================================
# LendMate Environment Configuration Template
# Copy this file to .env and configure your values. NEVER commit .env to Git.
#
# Linux/macOS:        cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-characters

# LOCAL DEVELOPMENT: Set to true
# PRODUCTION REQUIREMENT: Must strictly be false!
DJANGO_DEBUG=true

# Allowed Hosts (comma-separated):
# Local development default:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# DJANGO_ALLOWED_HOSTS=lendmate.example.com,your-app.up.railway.app

# CSRF Trusted Origins (comma-separated with scheme, required for forms on remote hosts):
# Local development default:
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Production example (must start with https://):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lendmate.example.com,https://your-app.up.railway.app

DJANGO_TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Application user credentials (used by Django and local/containerized MySQL)
MYSQL_DATABASE=lendmate
MYSQL_USER=lendmate
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Docker Compose Root Password (strictly isolated to the MySQL container setup):
# MYSQL_ROOT_PASSWORD=

# Optional Remote MySQL / Cloud Database Aliases (supported as alternatives to MYSQL_*):
# DB_NAME=lendmate
# DB_USER=lendmate
# DB_PASSWORD=
# DB_HOST=your-remote-mysql-host.example.com
# DB_PORT=3306

# Optional Remote MySQL TLS / SSL Configuration (e.g. AWS RDS, Railway, DigitalOcean):
# Provide absolute path to trusted CA bundle (e.g. /etc/ssl/certs/ca-certificates.crt):
# MYSQL_SSL_CA=
# Enforce secure certificate verification (e.g. VERIFY_IDENTITY, VERIFY_CA, REQUIRED):
# MYSQL_SSL_MODE=

# ------------------------------------------------------------------------------
# 3. REDIS (Celery Task Queue & Result Backend)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. WHATSAPP NOTIFICATION PROVIDER (Meta WhatsApp Business Platform Cloud API)
# ------------------------------------------------------------------------------
# SAFE DEFAULT: MockWhatsAppBackend (simulated, no real messages sent, status=MOCKED)
# Keep this default until real Meta credentials are deliberately configured!
WHATSAPP_BACKEND=notifications.whatsapp.MockWhatsAppBackend

# PRODUCTION LIVE CONFIGURATION:
# WHATSAPP_BACKEND=notifications.whatsapp.MetaWhatsAppCloudBackend
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-business-account-id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-challenge-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-webhook-signature-validation

# Custom approved template names (defaults match recommended Meta templates):
# WHATSAPP_TEMPLATE_LOAN_CREATED=lendmate_loan_created
# WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=lendmate_payment_received
# WHATSAPP_TEMPLATE_MONTHLY_REMINDER=lendmate_monthly_reminder
# WHATSAPP_TEMPLATE_OVERDUE_REMINDER=lendmate_overdue_reminder
# WHATSAPP_TEMPLATE_LOAN_CLOSED=lendmate_loan_closed
# WHATSAPP_TEMPLATE_LANGUAGE=en

# ------------------------------------------------------------------------------
# 5. SMS PROVIDER (Inactive; preserved for future multi-channel expansion)
# ------------------------------------------------------------------------------
# SMS_BACKEND=notifications.sms.MockSMSBackend
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=LNDMAT
# MSG91_ROUTE=4

# ------------------------------------------------------------------------------
# 6. EMAIL CONFIGURATION (Password reset)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LendMate <no-reply@lendmate.local>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------------------------
# 7. PRODUCTION SECURITY HARDENING (Active only when DJANGO_DEBUG=false)
# ------------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=true
